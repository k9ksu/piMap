# --- Secrets / local config (contains live QRZ API key) ---
config.py

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- Runtime data / logs ---
logs/
*.log
*.log.*

# --- User-placed WSPR target dots ---
targets.json

# --- User UI preferences (chosen alert chime, etc.) ---
ui_prefs.json

# --- Caches that shouldn't be in source control ---
data/*_cache.json
data/*_cache.txt

# --- OS / editor cruft ---
.DS_Store
*.swp
*~
.vscode/
.idea/

# stray editor backup
config.py.bak
*.bak

# --- piMap 2.0: built from data/maptiles by tools/build_pyramid.py ---
data/pyramid/

# --- piMap 2.0 runtime state ---
data/tv_view.json
